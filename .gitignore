# ==============================================================================
# SECRETS, CREDENTIALS & SENSITIVE KEYS (STRICT FOR PUBLIC REPO)
# ==============================================================================
# Environment variable files (never commit real credentials)
.env
.env.*
.envrc
!.env.example

# Private and public cryptographic keys & certificates
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pubxml

# Cloud provider credentials & service account tokens
*.credentials
credentials.json
client_secret*.json
service_account*.json
*service-account*.json
.aws/
.gcp/
.azure/
gcloud/

# Terraform local state and variable files
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Local databases & session storage
*.sqlite
*.sqlite3
*.db
*.session

# Secrets scanner baselines with private findings
.secrets.baseline.local

# ==============================================================================
# PYTHON RUNTIME, PACKAGING & BYTECODE
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments & uv
.venv/
env/
venv/
ENV/
.uv/

