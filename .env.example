# ==============================================================================
# NEXUSOPS ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to '.env' and fill in local development credentials.
# NOTE: The '.env' file is ignored by Git and must NEVER be committed.
# ==============================================================================

# Core Application Settings
APP_NAME=enterprise-cloud-platform
ENVIRONMENT=development
CLOUD_PROVIDER=local
DEBUG=true

# Security & Cryptographic Tokens (Generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-local-dev-mock-secret-key-64-characters-long-example
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Persistence (PostgreSQL asyncpg)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password_here
DB_NAME=enterprise_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30.0

# Ephemeral Distributed Cache & Rate Limiting (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DEFAULT_TTL_SECONDS=3600

# LLM & AI Service Providers (Used in Modules 05 & 06)
# Store your local development keys here; NEVER commit actual keys to Git.
OPENAI_API_KEY=sk-placeholder-key-for-local-testing
ANTHROPIC_API_KEY=sk-ant-placeholder-key-for-local-testing
